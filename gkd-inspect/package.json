{
  "name": "@gkd-kit/inspect",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild:mirror": "node ./scripts/updateVersion.ts",
    "build:mirror": "cross-env MIRROR=ON vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint:check": "eslint .",
    "lint": "eslint --cache --fix .",
    "check": "pnpm lint:check && pnpm type-check && pnpm test && pnpm build",
    "postpublish": "curl -X PUT https://registry-direct.npmmirror.com/@gkd-kit/inspect/sync"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkd-kit/inspect.git",
    "directory": "gkd-inspect"
  },
  "files": [
    "./dist"
  ]
}
