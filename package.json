{
  "name": "@gkd-kit/inspect",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild:mirror": "node ./scripts/updateVersion.ts",
    "build:mirror": "cross-env MIRROR=ON vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "test:log": "node --test --experimental-strip-types src/views/log/*.test.ts",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint --cache --fix .",
    "format": "prettier --cache --write --ignore-unknown .",
    "postinstall": "simple-git-hooks",
    "postpublish": "curl -X PUT https://registry-direct.npmmirror.com/@gkd-kit/inspect/sync"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gkd-kit/inspect"
  },
  "files": [
    "./dist"
  ],
  "dependencies": {
    "@antv/g6": "catalog:",
    "@eslint/js": "catalog:",
    "@gkd-kit/api": "catalog:",
    "@gkd-kit/selector": "catalog:",
    "@gkd-kit/wasm_matches": "catalog:",
    "@tsconfig/node20": "catalog:",
    "@types/file-saver": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/sql.js": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vueuse/components": "catalog:",
    "@vueuse/core": "catalog:",
    "browser-fs-access": "catalog:",
    "compressorjs": "catalog:",
    "cross-env": "catalog:",
    "dayjs": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "file-saver": "catalog:",
    "globals": "catalog:",
    "json5": "catalog:",
    "jszip": "catalog:",
    "lint-staged": "catalog:",
    "localforage": "catalog:",
    "lodash-es": "catalog:",
    "naive-ui": "catalog:",
    "normalize.css": "catalog:",
    "p-limit": "catalog:",
    "pkg-exports": "catalog:",
    "prettier": "catalog:",
    "sass": "catalog:",
    "simple-git": "catalog:",
    "simple-git-hooks": "catalog:",
    "sql.js": "catalog:",
    "svgo": "catalog:",
    "terser": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "universal-base64url": "catalog:",
    "unocss": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-data": "catalog:",
    "unplugin-vue-components": "catalog:",
    "update-browserslist-db": "catalog:",
    "user-attachments": "catalog:",
    "vite": "catalog:",
    "vite-plugin-monkey": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix"
    ],
    "**/*.{scss,json,md}": [
      "prettier --write"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.6.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "error"
    }
  }
}
