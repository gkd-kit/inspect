{
  "name": "gkd-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir gkd-inspect run dev",
    "build": "pnpm --dir gkd-inspect run build",
    "build:mirror": "pnpm --dir gkd-inspect run build:mirror",
    "delete-issue-comments": "node ./scripts/deleteIssueComments.ts",
    "preview": "pnpm --dir gkd-inspect run preview",
    "test": "pnpm --dir gkd-inspect run test",
    "test:watch": "pnpm --dir gkd-inspect run test:watch",
    "type-check": "pnpm type-check:root && pnpm --dir gkd-inspect run type-check && pnpm --dir gkd-server run type-check",
    "type-check:root": "tsc -p tsconfig.json",
    "lint:check": "pnpm --dir gkd-inspect run lint:check",
    "lint": "pnpm --dir gkd-inspect run lint",
    "dev:server": "pnpm --dir gkd-server run dev",
    "check": "pnpm type-check:root && pnpm --dir gkd-inspect run check && pnpm --dir gkd-server run check",
    "check:server": "pnpm --dir gkd-server run check",
    "test:server": "pnpm --dir gkd-server run test",
    "deploy:server": "pnpm --dir gkd-server run deploy",
    "format": "prettier --cache --write --ignore-unknown .",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@antv/g6": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@eslint/js": "catalog:",
    "@gkd-kit/api": "catalog:",
    "@gkd-kit/selector": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/file-saver": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/sql.js": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/router": "catalog:",
    "browser-fs-access": "catalog:",
    "compressorjs": "catalog:",
    "cross-env": "catalog:",
    "dayjs": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "fflate": "catalog:",
    "file-saver": "catalog:",
    "globals": "catalog:",
    "hono": "catalog:",
    "json5": "catalog:",
    "jszip": "catalog:",
    "lint-staged": "catalog:",
    "localforage": "catalog:",
    "lodash-es": "catalog:",
    "naive-ui": "catalog:",
    "p-limit": "catalog:",
    "prettier": "catalog:",
    "retrace-wasm": "catalog:",
    "simple-git": "catalog:",
    "simple-git-hooks": "catalog:",
    "sql.js": "catalog:",
    "svgo": "catalog:",
    "tailwindcss": "catalog:",
    "terser": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "universal-base64url": "catalog:",
    "unplugin-data": "catalog:",
    "user-attachments": "catalog:",
    "vite": "catalog:",
    "vite-plugin-monkey": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "**/*.{css,json,md}": [
      "prettier --write"
    ],
    "gkd-inspect/**/*.{ts,tsx,vue}": [
      "pnpm --dir gkd-inspect exec eslint --fix"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "error"
    }
  }
}
